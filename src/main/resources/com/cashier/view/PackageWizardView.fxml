<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cashier.packager.PackageWizardController"
      prefWidth="800" prefHeight="750" styleClass="wizard-root">

    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <!-- 标题 -->
    <HBox alignment="CENTER_LEFT" spacing="15" styleClass="wizard-header">
        <ImageView fitWidth="48" fitHeight="48" preserveRatio="true">
            <image>
                <Image url="@/images/logos/app-icon.png"/>
            </image>
        </ImageView>
        <VBox spacing="5">
            <Label text="%wizard.title" styleClass="wizard-title"/>
            <Label text="%wizard.subtitle" styleClass="wizard-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="versionLabel" text="Version 2.5.8" styleClass="wizard-version"/>
    </HBox>

    <Separator/>

    <!-- 步骤指示器 -->
    <HBox alignment="CENTER" spacing="10">
        <padding>
            <Insets topRightBottomLeft="15"/>
        </padding>
        <ToggleButton fx:id="step1Button" text="%wizard.step1" selected="true" styleClass="step-button"/>
        <Label text="→" styleClass="step-arrow"/>
        <ToggleButton fx:id="step2Button" text="%wizard.step2" styleClass="step-button"/>
        <Label text="→" styleClass="step-arrow"/>
        <ToggleButton fx:id="step3Button" text="%wizard.step3" styleClass="step-button"/>
        <Label text="→" styleClass="step-arrow"/>
        <ToggleButton fx:id="step4Button" text="%wizard.step4" styleClass="step-button"/>
    </HBox>

    <!-- 主内容区域 - 包装在 ScrollPane 中以支持滚动 -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="wizard-scroll">
        <VBox fx:id="wizardContainer" spacing="15" styleClass="wizard-content">

        <!-- 步骤 1: 基本信息 -->
        <VBox fx:id="step1Content" spacing="15">
            <Label text="%wizard.section.basic_info" styleClass="section-title"/>

            <GridPane hgap="15" vgap="15">
                <Label text="%wizard.label.app_name" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="appNameField" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="%wizard.label.version" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="appVersionField" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="%wizard.label.vendor" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="vendorField" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="%wizard.label.icon" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <TextField fx:id="iconPathField" prefWidth="300" promptText="%wizard.prompt.icon"/>
                    <Button text="%wizard.button.browse" onAction="#handleBrowseIcon"/>
                </HBox>

                <Label text="%wizard.label.description" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.valignment="TOP"/>
                <TextArea fx:id="descriptionArea" prefRowCount="3" prefWidth="400" GridPane.columnIndex="1" GridPane.rowIndex="4"
                          promptText="%wizard.prompt.description"/>
            </GridPane>
        </VBox>

        <!-- 步骤 2: 打包选项 -->
        <VBox fx:id="step2Content" spacing="15" visible="false" managed="false">
            <Label text="%wizard.section.package_options" styleClass="section-title"/>

            <VBox spacing="10" styleClass="option-card">
                <CheckBox fx:id="embedJreCheckBox" text="%wizard.checkbox.embed_jre" selected="true"/>
                <Label text="%wizard.checkbox.embed_jre_desc" styleClass="help-text">
                    <VBox.margin>
                        <Insets left="25"/>
                    </VBox.margin>
                </Label>
            </VBox>

            <VBox spacing="10" styleClass="option-card">
                <CheckBox fx:id="createExeInstallerCheckBox" text="%wizard.checkbox.create_exe" selected="false"/>
                <Label text="%wizard.checkbox.create_exe_desc" styleClass="help-text">
                    <VBox.margin>
                        <Insets left="25"/>
                    </VBox.margin>
                </Label>
            </VBox>

            <VBox spacing="10" styleClass="option-card">
                <CheckBox fx:id="createShortcutCheckBox" text="%wizard.checkbox.create_shortcut" selected="true"/>
            </VBox>

            <VBox spacing="10" styleClass="option-card">
                <CheckBox fx:id="addMenuCheckBox" text="%wizard.checkbox.add_menu" selected="true"/>
            </VBox>

            <VBox spacing="10" styleClass="option-card">
                <CheckBox fx:id="dirChooserCheckBox" text="%wizard.checkbox.dir_chooser" selected="true"/>
            </VBox>

            <GridPane hgap="15" vgap="15">
                <Label text="%wizard.label.min_memory" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Spinner fx:id="memoryMinSpinner" prefWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="%wizard.label.max_memory" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Spinner fx:id="memoryMaxSpinner" prefWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            </GridPane>
        </VBox>

        <!-- 步骤 3: 数据库配置 -->
        <VBox fx:id="step3Content" spacing="15" visible="false" managed="false">
            <Label text="%wizard.section.db_config" styleClass="section-title"/>

            <GridPane hgap="15" vgap="15">
                <Label text="%wizard.label.db_type" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="dbTypeComboBox" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="%wizard.label.host" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="dbHostField" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="%wizard.label.port" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="dbPortField" prefWidth="100" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="%wizard.label.db_name" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="dbNameField" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="%wizard.label.username" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <TextField fx:id="dbUsernameField" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label text="%wizard.label.password" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <PasswordField fx:id="dbPasswordField" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
            </GridPane>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="testConnectionButton" text="%wizard.button.test_connection" onAction="#handleTestConnection"/>
                <Label text="%wizard.help.test_connection" styleClass="help-text"/>
            </HBox>
        </VBox>

        <!-- 步骤 4: 确认打包 -->
        <VBox fx:id="step4Content" spacing="15" visible="false" managed="false">
            <Label text="%wizard.section.confirm" styleClass="section-title"/>

            <VBox spacing="10" styleClass="option-card">
                <Label text="%wizard.label.summary" styleClass="summary-title"/>
                <GridPane hgap="15" vgap="5">
                    <Label text="%wizard.label.app_name" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="help-text"/>
                    <Label fx:id="summaryAppName" text="LiSuan" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="summary-value"/>

                    <Label text="%wizard.label.version" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="help-text"/>
                    <Label fx:id="summaryVersion" text="2.5.8" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="summary-value"/>

                    <Label text="%wizard.label.embed_jre" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="help-text"/>
                    <Label fx:id="summaryEmbedJre" text="%wizard.yes" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="summary-value"/>

                    <Label text="%wizard.label.output_dir" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="help-text"/>
                    <Label fx:id="summaryOutputDir" text="target/dist" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="summary-value"/>
                </GridPane>
            </VBox>

            <GridPane hgap="15" vgap="15">
                <Label text="%wizard.label.output_dir" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <TextField fx:id="outputDirField" prefWidth="400" promptText="%wizard.prompt.output_dir"/>
                    <Button text="%wizard.button.browse" onAction="#handleBrowseOutputDir"/>
                </HBox>
            </GridPane>

            <TextArea fx:id="instructionsArea" prefRowCount="6" prefWidth="750" editable="false" wrapText="true" styleClass="info-area"
                      text="%wizard.instructions"/>
        </VBox>
        </VBox>
    </ScrollPane>

    <!-- 进度和日志区域 -->
    <VBox spacing="8">
        <ProgressBar fx:id="progressBar" prefWidth="750" progress="0" visible="false"/>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <ProgressIndicator fx:id="progressIndicator" prefWidth="25" prefHeight="25" visible="false"/>
            <Label fx:id="statusLabel" text="" styleClass="status-label"/>
        </HBox>
        <TextArea fx:id="logTextArea" prefRowCount="4" editable="false" styleClass="log-area"/>
    </VBox>

    <!-- 导航按钮 -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <padding>
            <Insets topRightBottomLeft="10"/>
        </padding>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="backButton" text="%wizard.button.back" onAction="#handleBack" prefWidth="100"/>
        <Button fx:id="nextButton" text="%wizard.button.next" onAction="#handleNext" prefWidth="100" styleClass="primary-button"/>
        <Button fx:id="finishButton" text="%wizard.button.finish" onAction="#handleFinish" prefWidth="100" visible="false" managed="false" styleClass="primary-button"/>
        <Button fx:id="cancelButton" text="%wizard.button.cancel" onAction="#handleCancel" prefWidth="80"/>
    </HBox>

</VBox>
