<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cashier.controller.PosModeController"
      spacing="0"
      styleClass="pos-mode-view">

    <!-- 顶部工具栏 -->
    <HBox spacing="20" styleClass="pos-toolbar" alignment="CENTER_LEFT">
        <padding>
            <Insets top="15" right="20" bottom="15" left="20"/>
        </padding>

        <!-- 系统标题 -->
        <Label text="%pos.title_with_icon" styleClass="pos-title"/>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- 当前用户信息 -->
        <VBox spacing="2" alignment="CENTER_LEFT">
            <Label fx:id="userNameLabel" text="%pos.user" styleClass="pos-user-name"/>
            <Label fx:id="userRoleLabel" text="%pos.cashier_role" styleClass="pos-secondary-text"/>
        </VBox>

        <!-- 用户头像（显示首字母） -->
        <StackPane fx:id="avatarContainer" prefWidth="40" prefHeight="40">
            <Circle fx:id="avatarCircle" radius="20" styleClass="pos-avatar-circle"/>
            <Label fx:id="avatarText" text="U" styleClass="pos-avatar-text"/>
        </StackPane>

        <!-- 退出按钮 -->
        <Button fx:id="exitButton"
                text="%pos.exit"
                onAction="#handleExit"
                prefWidth="90"
                prefHeight="40"
                styleClass="danger-button, pos-action-button"/>
    </HBox>

    <!-- 主内容区域 - 直接显示收银台 -->
    <StackPane VBox.vgrow="ALWAYS" styleClass="pos-content">
        <!-- 这里的内容会通过PosModeController动态加载CartView -->
        <VBox fx:id="cartContainer" VBox.vgrow="ALWAYS"/>
    </StackPane>

    <!-- 底部状态栏 -->
    <HBox spacing="15" styleClass="pos-status-bar" alignment="CENTER_LEFT">
        <padding>
            <Insets top="10" right="20" bottom="10" left="20"/>
        </padding>

        <Label fx:id="dateLabel" text="2026-02-23" styleClass="pos-status-text"/>
        <Label fx:id="timeLabel" text="18:00:00" styleClass="pos-status-text"/>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- 交接班按钮 -->
        <Button fx:id="shiftButton"
                text="%pos.shift"
                onAction="#handleShift"
                prefWidth="140"
                prefHeight="40"
                styleClass="primary-button, pos-action-button"/>

        <Label fx:id="statusLabel" text="%pos.ready" styleClass="pos-ready-text"/>
    </HBox>

</VBox>
