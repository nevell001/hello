<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cashier.controller.SearchController"
      spacing="0"
      styleClass="search-view">

    <!-- 顶部搜索栏 -->
    <HBox styleClass="search-header" spacing="10" alignment="CENTER_LEFT">
        <padding>
            <Insets top="15" right="15" bottom="15" left="15"/>
        </padding>
        <Label text="🔍" styleClass="emoji-icon-lg"/>
        <TextField fx:id="searchField"
                   promptText="%search.placeholder"
                   HBox.hgrow="ALWAYS"
                   styleClass="search-input"/>
        <Button fx:id="closeButton" text="✕" styleClass="icon-button" onAction="#handleClose"/>
    </HBox>

    <!-- 搜索结果列表 -->
    <ListView fx:id="resultsList"
              VBox.vgrow="ALWAYS"
              styleClass="search-results"
              focusTraversable="false"/>

    <!-- 底部提示 -->
    <HBox styleClass="search-footer" spacing="10">
        <padding>
            <Insets top="8" right="15" bottom="8" left="15"/>
        </padding>
        <Label text="%search.results" styleClass="text-muted, text-sm"/>
        <Label fx:id="resultCountLabel" text="0" styleClass="text-primary, text-sm, font-bold"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="%search.keyboard_select" styleClass="text-muted, text-xs"/>
        <Label text="%search.keyboard_open" styleClass="text-muted, text-xs"/>
        <Label text="%search.keyboard_close" styleClass="text-muted, text-xs"/>
    </HBox>

</VBox>
