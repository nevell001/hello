<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cashier.controller.ShiftController"
      spacing="0"
      styleClass="shift-view-root">

    <!-- 顶部工具栏 -->
    <HBox spacing="12" styleClass="shift-toolbar" alignment="CENTER_LEFT">
        <padding>
            <Insets top="12" right="16" bottom="12" left="16"/>
        </padding>

        <Label text="📊" styleClass="shift-toolbar-icon"/>
        <Label text="%shift.title" styleClass="shift-toolbar-title"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button fx:id="startShiftButton" text="%shift.start" onAction="#handleStartShift"
                prefWidth="100" prefHeight="38" styleClass="shift-btn, shift-btn-primary"/>
        <Button fx:id="endShiftButton" text="%shift.end" onAction="#handleEndShift"
                prefWidth="100" prefHeight="38" styleClass="shift-btn, shift-btn-warning"/>
        <Button fx:id="viewDetailButton" text="%shift.view_detail" onAction="#handleViewDetail"
                prefWidth="110" prefHeight="38" styleClass="shift-btn, shift-btn-secondary"/>
        <Button fx:id="exportButton" text="%shift.export" onAction="#handleExport"
                prefWidth="90" prefHeight="38" styleClass="shift-btn, shift-btn-secondary"/>
        <Button fx:id="refreshButton" text="%shift.refresh" onAction="#handleRefresh"
                prefWidth="90" prefHeight="38" styleClass="shift-btn, shift-btn-secondary"/>
    </HBox>

    <Separator styleClass="shift-separator"/>

    <!-- 筛选栏 -->
    <HBox fx:id="filterBar" spacing="12" styleClass="shift-filter-bar" alignment="CENTER_LEFT">
        <padding>
            <Insets top="10" right="16" bottom="10" left="16"/>
        </padding>

        <Label text="%shift.date_from" styleClass="shift-filter-label"/>
        <DatePicker fx:id="startDatePicker" prefWidth="150" styleClass="shift-datepicker"/>

        <Label text="%shift.date_to" styleClass="shift-filter-label"/>
        <DatePicker fx:id="endDatePicker" prefWidth="150" styleClass="shift-datepicker"/>

        <Separator orientation="VERTICAL" styleClass="shift-separator-vertical"/>

        <Label text="%shift.search_label" styleClass="shift-filter-label"/>
        <TextField fx:id="searchField" promptText="%shift.search_hint"
                   prefWidth="200" styleClass="shift-search-field" onAction="#handleSearch"/>
        <Button text="%common.search" onAction="#handleSearch"
                prefWidth="70" prefHeight="34" styleClass="shift-btn, shift-btn-secondary"/>
        <Button text="%common.clear" onAction="#handleClearSearch"
                prefWidth="70" prefHeight="34" styleClass="shift-btn, shift-btn-secondary"/>
    </HBox>

    <!-- 统计卡片 -->
    <HBox spacing="12" styleClass="shift-stats-container">
        <padding>
            <Insets top="12" right="16" bottom="0" left="16"/>
        </padding>

        <VBox styleClass="shift-stat-card" spacing="4" HBox.hgrow="ALWAYS">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>
            <Label text="%shift.stat_count" styleClass="shift-stat-label"/>
            <Label fx:id="countLabel" styleClass="shift-stat-value"/>
        </VBox>

        <VBox styleClass="shift-stat-card" spacing="4" HBox.hgrow="ALWAYS">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>
            <Label text="%shift.stat_revenue" styleClass="shift-stat-label"/>
            <Label fx:id="totalRevenueLabel" styleClass="shift-stat-value shift-stat-value-success"/>
        </VBox>

        <VBox styleClass="shift-stat-card" spacing="4" HBox.hgrow="ALWAYS">
            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>
            <Label text="%shift.stat_transactions" styleClass="shift-stat-label"/>
            <Label fx:id="totalTransactionLabel" styleClass="shift-stat-value shift-stat-value-warning"/>
        </VBox>
    </HBox>

    <!-- 图表区域 -->
    <ScrollPane fx:id="chartsScrollPane" fitToWidth="true" VBox.vgrow="NEVER" prefHeight="280" styleClass="shift-charts-scroll">
        <HBox spacing="12" styleClass="shift-charts-container">
            <padding>
                <Insets top="12" right="16" bottom="12" left="16"/>
            </padding>

            <!-- 班次收入柱状图 -->
            <VBox spacing="8" styleClass="shift-chart-card" HBox.hgrow="ALWAYS">
                <Label text="%shift.revenue_chart" styleClass="shift-chart-title"/>
                <BorderPane VBox.vgrow="ALWAYS">
                    <center>
                        <BarChart fx:id="shiftRevenueBarChart" prefHeight="200" legendVisible="false">
                            <xAxis>
                                <CategoryAxis label="%shift.shift_axis"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis label="%shift.revenue_axis"/>
                            </yAxis>
                        </BarChart>
                    </center>
                </BorderPane>
            </VBox>

            <!-- 支付方式饼图 -->
            <VBox spacing="8" styleClass="shift-chart-card" prefWidth="350">
                <Label text="%shift.payment_chart" styleClass="shift-chart-title"/>
                <BorderPane VBox.vgrow="ALWAYS">
                    <center>
                        <PieChart fx:id="paymentMethodPieChart" prefHeight="200" legendSide="RIGHT"/>
                    </center>
                </BorderPane>
            </VBox>
        </HBox>
    </ScrollPane>

    <Separator styleClass="shift-separator"/>

    <!-- 交接班记录表格 -->
    <TableView fx:id="shiftTable"
              VBox.vgrow="ALWAYS"
              styleClass="shift-table">
        <columns>
            <TableColumn fx:id="shiftIdColumn" text="%shift.shift_id" prefWidth="150"/>
            <TableColumn fx:id="operatorColumn" text="%shift.operator" prefWidth="120"/>
            <TableColumn fx:id="timeColumn" text="%shift.time" prefWidth="160"/>
            <TableColumn fx:id="durationColumn" text="%shift.duration" prefWidth="100"/>
            <TableColumn fx:id="transactionColumn" text="%shift.transaction_count" prefWidth="80"/>
            <TableColumn fx:id="revenueColumn" text="%shift.revenue" prefWidth="100"/>
            <TableColumn fx:id="paymentColumn" text="%shift.payment_methods" prefWidth="300"/>
        </columns>
        <placeholder>
            <Label text="%shift.no_data" styleClass="shift-placeholder"/>
        </placeholder>
    </TableView>

</VBox>
