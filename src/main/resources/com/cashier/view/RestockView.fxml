<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cashier.controller.RestockController"
      spacing="12"
      styleClass="restock-view"
      prefWidth="450"
      prefHeight="380">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- 标题 -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="titleLabel"
               text="%restock.title"
               styleClass="text-primary, title-xl"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="%restock.subtitle" styleClass="text-muted, text-sm, font-italic"/>
    </HBox>

    <!-- 商品信息卡片 -->
    <VBox spacing="8" styleClass="product-info-card">
        <padding>
            <Insets top="12" right="15" bottom="12" left="15"/>
        </padding>
        <Label fx:id="productLabel" text="" styleClass="text-default, product-title"/>
        <HBox spacing="20" alignment="CENTER_LEFT">
            <Label fx:id="currentStockLabel" text="" styleClass="text-muted, text-md"/>
            <Label fx:id="costPriceLabel" text="" styleClass="text-muted, text-md"/>
        </HBox>
    </VBox>

    <!-- 表单 -->
    <GridPane hgap="15" vgap="12">
        <padding>
            <Insets top="5" right="0" bottom="5" left="0"/>
        </padding>
        <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="80"/>
            <ColumnConstraints hgrow="SOMETIMES" prefWidth="250"/>
        </columnConstraints>

        <!-- 补货数量 -->
        <Label text="%restock.quantity" GridPane.columnIndex="0" GridPane.rowIndex="0"
               styleClass="text-default, form-label-strong"/>
        <TextField fx:id="quantityField"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"
                   prefWidth="250" promptText="%restock.quantity_hint"
                   styleClass="control-lg"/>

        <!-- 入库来源 -->
        <Label text="%restock.source" GridPane.columnIndex="0" GridPane.rowIndex="1"
               styleClass="text-default, form-label-strong"/>
        <ComboBox fx:id="sourceComboBox"
                  GridPane.columnIndex="1" GridPane.rowIndex="1"
                  prefWidth="250" editable="true"
                  styleClass="control-lg"/>

        <!-- 备注 -->
        <Label text="%restock.reason" GridPane.columnIndex="0" GridPane.rowIndex="2"
               styleClass="text-default, form-label-strong"/>
        <TextField fx:id="reasonField"
                   GridPane.columnIndex="1" GridPane.rowIndex="2"
                   prefWidth="250" promptText="%restock.reason_hint"
                   styleClass="control-lg"/>
    </GridPane>

    <!-- 实时预览信息 -->
    <VBox spacing="8" styleClass="preview-box">
        <padding>
            <Insets top="10" right="15" bottom="10" left="15"/>
        </padding>
        <Label text="%restock.preview" styleClass="text-muted, text-md, font-bold"/>
        <HBox spacing="30" alignment="CENTER_LEFT">
            <VBox spacing="2">
                <Label text="%restock.after_stock" styleClass="text-muted, text-xs"/>
                <Label fx:id="afterStockLabel" text="-" styleClass="text-primary, preview-value"/>
            </VBox>
            <VBox spacing="2">
                <Label text="%restock.total_cost" styleClass="text-muted, text-xs"/>
                <Label fx:id="totalCostLabel" text="-" styleClass="text-warning, preview-value"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- 错误提示 -->
    <Label fx:id="errorLabel"
           text=""
           styleClass="text-danger, text-sm"/>

    <!-- 按钮区域 -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="cancelButton"
                text="%restock.cancel"
                onAction="#handleCancel"
                prefWidth="90"
                prefHeight="38"
                styleClass="secondary-button"/>
        <Button fx:id="confirmButton"
                text="%restock.confirm"
                onAction="#handleConfirm"
                prefWidth="90"
                prefHeight="38"
                styleClass="primary-button"/>
    </HBox>

</VBox>
