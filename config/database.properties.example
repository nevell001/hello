# 数据库连接配置 (示例)
# 狸算(LiSuan)收银系统

# 数据库连接 URL
# 生产环境建议使用 sslMode=REQUIRED，开发环境可用 sslMode=PREFERRED
db.url=jdbc:mysql://localhost:3306/lisuan_system?sslMode=REQUIRED&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&characterEncoding=UTF-8

# 数据库用户名
db.username=lisuan

# 数据库密码
# 安全提示：建议通过环境变量设置密码，以防泄露
# export CASHIER_DB_PASSWORD=your_password
db.password=
