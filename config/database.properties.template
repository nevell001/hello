# 数据库连接配置
# 狸算(LiSuan)收银系统

# 数据库连接 URL
db.url=jdbc:mysql://localhost:3306/lisuan_system?sslMode=PREFERRED&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&characterEncoding=UTF-8

# 数据库用户名
db.username=lisuan

# 数据库密码
# 安全提示：为了生产环境安全，强烈建议通过环境变量设置密码
# Windows: set CASHIER_DB_PASSWORD=your_password
# Linux/Mac: export CASHIER_DB_PASSWORD=your_password
# 如果不使用环境变量，请在此处填写密码（不推荐用于生产）
db.password=YOUR_DATABASE_PASSWORD_HERE

# 连接池配置
db.pool.size=10
db.connection.timeout=30000
db.idle.timeout=600000
db.max.lifetime=1800000

# 备份配置
backup.mysql.container=lisuan-mysql
