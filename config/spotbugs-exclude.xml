<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- JavaFX owns the Application lifecycle; start() is where the active instance becomes available. -->
    <Match>
        <Class name="com.cashier.CashierSystemFXApplication"/>
        <Method name="start"/>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
    </Match>

    <!-- BackupService retains a shared configuration for its static backup API and refreshes it on start. -->
    <Match>
        <Class name="com.cashier.service.BackupService"/>
        <Method name="start"/>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
    </Match>
</FindBugsFilter>
