# API 服务器配置
# ============================================
# ⚠️ 安全警告：生产环境请使用环境变量！
# ============================================
# 推荐方式（更安全）：
#   export TOKEN_SECRET="your_random_64_char_secret"
#   export CORS_ALLOWED_ORIGINS="https://your-domain.com"
# ============================================

# API 服务器开关（默认关闭；完成下方安全配置后再显式开启）
api.enabled=false

# API 端口
api.port=8080

# API 主机绑定（默认仅本机；确需远程访问时再配置具体内网地址）
api.host=127.0.0.1

# ============================================
# CORS 配置（重要！）
# ============================================
# 开发环境确需放开时可在本机临时改为 *，不要提交或发布该配置
# 生产环境: 必须限制为具体域名，多个域名用逗号分隔
# 示例: https://pos.example.com,https://admin.example.com
cors.allowed.origins=https://pos.example.com

# Token 过期时间（小时）
token.expire.hours=24

# ============================================
# TOKEN 密钥（重要！）
# ============================================
# ⚠️ 生产环境必须使用强随机密钥（至少64字符）
# ⚠️ 建议使用环境变量 TOKEN_SECRET 设置
# 生成方式: openssl rand -base64 48
token.secret=REPLACE_WITH_RANDOM_64_CHAR_SECRET_FROM_ENVIRONMENT
